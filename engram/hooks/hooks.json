{
  "description": "Engram memory hooks use the installed Superyak runtime. The launcher resolves canonical source and its explicit memory-home configuration, including when this plugin is cached.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ENGRAM_HARNESS=claude-code \"$HOME/.local/bin/superyak-runtime\" hook nudge",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ENGRAM_HARNESS=claude-code \"$HOME/.local/bin/superyak-runtime\" hook wake",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "ENGRAM_HARNESS=claude-code \"$HOME/.local/bin/superyak-runtime\" hook sleep",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
