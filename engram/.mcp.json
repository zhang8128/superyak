{
  "mcpServers": {
    "engram": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/superyak-runtime\" mcp"
      ],
      "env": {
        "ENGRAM_HARNESS": "claude-code"
      }
    },
    "reader": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/kairos/Projects/reader",
        "python",
        "server.py"
      ],
      "env": {
        "READER_HOME": "/Users/kairos/Projects/reader"
      }
    }
  }
}
