{
  "mcpServers": {
    "engram": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/superyak-runtime\" mcp"
      ],
      "env": {
        "ENGRAM_HARNESS": "claude-code"
      }
    },
    "team": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME/.local/bin/superyak-runtime\" team"
      ],
      "env": {
        "SUPERYAK_TEAM_LEAD_KIND": "claude"
      }
    }
  }
}
