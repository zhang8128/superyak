      "priority": 1,
      "purpose": [
        "biomedical discovery",
        "bibliographic updates",
        "corrections"
      ],
      "access": [
        "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
        "https://ftp.ncbi.nlm.nih.gov/pubmed/"
      ],
      "identity": [
        "PMID",
        "source update date",
        "raw XML hash"
      ],
      "reuse_basis": "Metadata access does not clear publisher copyright in abstracts. Resolve text rights per record.",
