# One shared nomic-embed-text model for every Engram process of this user.
# Install: cp scripts/superyak-embedder.service ~/.config/systemd/user/
#          systemctl --user enable --now superyak-embedder
# then add to ~/.config/superyak/runtime.json:
#          "embedder_socket": "/run/user/<uid>/superyak/embedder.sock"
[Unit]
Description=Superyak shared embedding service

[Service]
ExecStart=%h/.local/bin/superyak-runtime embedder
Restart=on-failure
RestartSec=5
# The model loads on the first request and is dropped after five idle minutes, so a quiet machine holds only the
# process (Andy, 2026-11-02: "engram should be able to be run with very little memory"). A request after a pause waits
# 2-3 s on the Pi for the reload. Loaded: ~1.1 GB; measured peak 1.8 GB on a full re-embed (2026-10-02).
Environment=ENGRAM_EMBED_IDLE_SECONDS=300
MemoryMax=3G
MemorySwapMax=0

[Install]
WantedBy=default.target
