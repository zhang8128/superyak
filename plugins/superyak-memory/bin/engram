#!/bin/sh
# Engram's MCP server for this session, from the checkout this plugin lives in. The memory home and the instance come
# from ~/.config/superyak/runtime.json (SUPERYAK_RUNTIME_CONFIG overrides), else $HOME and "default". The shared
# embedder's socket is passed only when it exists: Engram fails loudly on a configured socket that isn't there, and
# without one it embeds in this process, loading the model only when it first embeds and dropping it when idle.
# `engram hook wake|nudge|sleep` runs one of Engram's hooks with the same settings. Wake and sleep read stored vectors.
# Nudge embeds each prompt, so it runs only with the shared embedder: in its own process it would load the model (about
# 850 MB, 2.6 s on the Pi) on every prompt.
set -eu
here=$(cd "$(dirname "$0")/../../.." && pwd)
if [ -n "${SUPERYAK_REPO:-}" ]; then
  repo=$SUPERYAK_REPO
elif [ -f "$here/engram/server.py" ]; then
  repo=$here  # run from a checkout (claude --plugin-dir)
else
  # An installed copy runs from Claude Code's plugin cache, outside any checkout: use the checkout the superyak
  # marketplace was added from (`claude plugin marketplace add <checkout>`).
  repo=$(python3 -I -c '
import json, os, sys
try:
    entry = json.load(open(sys.argv[1])).get("superyak") or {}
except (OSError, ValueError, AttributeError):
    entry = {}
source = entry.get("source") if isinstance(entry.get("source"), dict) else {}
for place in (source.get("path"), entry.get("installLocation")):
    if isinstance(place, str) and os.path.isfile(os.path.join(place, "engram", "server.py")):
        print(place)
        break
' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/known_marketplaces.json" 2>/dev/null || true)
  if [ -z "$repo" ]; then
    echo "superyak-memory: can't find the Superyak checkout; set SUPERYAK_REPO, or add the marketplace from it" >&2
    exit 1
  fi
fi
python="$repo/engram/.venv/bin/python"
if [ ! -x "$python" ]; then
  echo "superyak-memory: no Engram environment at $repo/engram/.venv; run make setup-engram there" >&2
  exit 1
fi
config=${SUPERYAK_RUNTIME_CONFIG:-$HOME/.config/superyak/runtime.json}
fields=$("$python" -I -c '
import json, sys
try:
    c = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    c = {}
print(c.get("memory_home") or "", c.get("default_instance") or "", c.get("embedder_socket") or "", sep="\n")
' "$config")
home=$(printf '%s\n' "$fields" | sed -n 1p)
instance=$(printf '%s\n' "$fields" | sed -n 2p)
socket=$(printf '%s\n' "$fields" | sed -n 3p)
export ENGRAM_HOME="${home:-$HOME}"
export ENGRAM_DEFAULT_INSTANCE="${instance:-default}"
if [ -n "$socket" ] && [ -S "$socket" ]; then
  export ENGRAM_EMBEDDER_SOCKET="$socket"
else
  unset ENGRAM_EMBEDDER_SOCKET
fi
case "${1:-}" in
  "") exec "$python" "$repo/engram/server.py" ;;
  hook)
    case "${2:-}" in
      nudge) [ -n "${ENGRAM_EMBEDDER_SOCKET:-}" ] || exit 0
             ENGRAM_HARNESS=claude-code exec "$python" "$repo/engram/hooks/nudge.py" ;;
      wake|sleep) ENGRAM_HARNESS=claude-code exec "$python" "$repo/engram/hooks/$2.py" ;;
    esac ;;
esac
echo "usage: engram [hook wake|nudge|sleep]" >&2
exit 2
