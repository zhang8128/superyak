{
  "name": "@lighthouse/workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Implementation-neutral semantic interchange protocol and reference conformance kit",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "proof": "pnpm --filter @lighthouse/conformance proof",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "zod": "4.4.3"
  }
}
