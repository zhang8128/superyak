{
  "description": "Engram memory hooks — wake up with memories at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/wake.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
