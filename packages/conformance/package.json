{
  "name": "@lighthouse/conformance",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Lighthouse conformance harness and reference proof",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@lighthouse/adapter-adna": "workspace:*",
    "@lighthouse/adapter-hyper": "workspace:*",
    "@lighthouse/bridge-hyper-adna": "workspace:*",
    "@lighthouse/calculus": "workspace:*",
    "@lighthouse/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
